# Preserved legacy incremental build configuration.  The top-level Makefile
# delegates to this file through `legacy` and `legacy-TARGET` targets.
BOARD ?= esp32s3
PORT ?= /dev/serial/by-id/usb-Espressif_USB_JTAG_serial_debug_unit_28:37:2F:F8:24:7C-if00
UPLOAD_PORT := $(PORT)
MONITOR_PORT := $(PORT)
CHIP ?= esp32
SKETCH ?= espAHRS.ino
ALIBS = ${HOME}/Arduino/libraries
GIT_VERSION := "$(shell git describe --abbrev=8 --dirty --always --tags 2>/dev/null || echo local)"

BUILD_MEMORY_TYPE = qio_qspi
BUILD_EXTRA_FLAGS += -DBOARD_HAS_PSRAM -DGIT_VERSION=\"$(GIT_VERSION)\"
EXCLUDE_DIRS = ${ALIBS}/lvgl|${ALIBS}/TFT_eSPI|${ALIBS}/LovyanGFX|${ALIBS}/jimlib|${ALIBS}/esp32csim
LIBS += ${ALIBS}/esp32jimlib ${ALIBS}/Arduino_CRC32
LIBS += ${ALIBS}/Adafruit_GFX_Library ${ALIBS}/Adafruit_ST7735_and_ST7789_Library
LIBS += ${ALIBS}/Adafruit_LSM9DS1_Library
LIBS += ${ALIBS}/SparkFun_ICM-20948_ArduinoLibrary/src/ICM_20948.cpp
LIBS += ${ALIBS}/SensorLib ${ALIBS}/XPowersLib ${ALIBS}/U8g2
LIBS += ${ALIBS}/Adafruit_BMP280_Library ${ALIBS}/Adafruit_LIS3MDL
LIBS += ${ALIBS}/Adafruit_BMP3XX_Library ${ALIBS}/Adafruit_BME280_Library
LIBS += ${ALIBS}/SparkFun_u-blox_GNSS_Arduino_Library/src/SparkFun_u-blox_GNSS_Arduino_Library.cpp
LIBS += ${ALIBS}/Adafruit_BusIO ${ALIBS}/Adafruit_Unified_Sensor
BUILD_EXTRA_FLAGS += -I${ALIBS}/U8g2/src -I${ALIBS}/SparkFun_ICM-20948_ArduinoLibrary/src
BUILD_EXTRA_FLAGS += -I${ALIBS}/SparkFun_u-blox_GNSS_Arduino_Library/src
LIBS += ${ALIBS}/esp32jimlib/src/espNowMux.cpp ${ALIBS}/esp32jimlib/src/jimlib.cpp
LIBS += ${ALIBS}/esp32jimlib/src/simulatedFailures.cpp
LIBS += ${ALIBS}/Arduino_CRC32/src/Arduino_CRC32.cpp ${ALIBS}/Arduino_CRC32/src/crc.cpp

# T-Display builds need the LovyanGFX display implementation.  Keep this
# conditional so the legacy GEEK build retains its original library set.
ifeq ($(DEVICE),tdisplay-s3)
BUILD_EXTRA_FLAGS += -DESPAHRS_TDISPLAY_S3
#BUILD_EXTRA_FLAGS += -I${ALIBS}/LovyanGFX/src
BUILD_EXTRA_FLAGS += -DESP_PLATFORM -DCONFIG_IDF_TARGET_ESP32S3 -DBOARD_HAS_PSRAM -DGIT_VERSION=\"$(GIT_VERSION)\"
LIBS += ${ALIBS}/LovyanGFX
# LovyanGFX contains many platform backends and an internal limits.h whose
# basename collides with the C++ standard header.  Keep only the ESP32-S3
# sources needed by display.hpp; this is the same exclusion strategy used by
# the working LVGL/LovyanGFX makefiles.
LGFX := ${ALIBS}/LovyanGFX/src/lgfx
PLATFORMS := ${LGFX}/v1/platforms
EXCLUDE_DIRS := ${ALIBS}/lvgl|${ALIBS}/TFT_eSPI|${ALIBS}/jimlib|${ALIBS}/esp32csim|${LGFX}/v0|${LGFX}/v1/platforms/arduino_default|${LGFX}/v1/platforms/esp32c3|${LGFX}/v1/platforms/esp32s2|${LGFX}/v1/platforms/esp8266|${LGFX}/v1/platforms/samd21|${LGFX}/v1/platforms/samd51|${LGFX}/v1/platforms/spresense|${LGFX}/v1/platforms/stm32|${LGFX}/internal|${ALIBS}/LovyanGFX/examples
EXCLUDE_DIRS := ${ALIBS}/lvgl|${ALIBS}/TFT_eSPI|${ALIBS}/jimlib|${ALIBS}/esp32csim|${LGFX}/v0|${PLATFORMS}/arduino_default|${PLATFORMS}/esp32|${PLATFORMS}/esp32c3|${PLATFORMS}/esp32s2|${PLATFORMS}/esp8266|${PLATFORMS}/samd21|${PLATFORMS}/samd51|${PLATFORMS}/spresense|${PLATFORMS}/stm32|${PLATFORMS}/rp2040|${PLATFORMS}/sdl|${PLATFORMS}/framebuffer|${PLATFORMS}/opencv|${LGFX}/internal|${ALIBS}/LovyanGFX/examples
LIBS += ${PLATFORMS}/esp32s3/Bus_Parallel8.cpp ${PLATFORMS}/esp32/common.cpp
endif

include ${ALIBS}/makeEspArduino/makeEspArduino.mk
